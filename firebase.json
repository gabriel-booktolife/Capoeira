{
  "apphosting": {
    "backendId": "chao-batido",
    "rootDir": ".",
    "ignore": [
      ".git",
      ".github",
      ".next",
      ".firebase",
      ".migration-backups",
      "node_modules",
      "functions",
      "tests",
      "e2e",
      "playwright-report",
      "test-results",
      "firebase-debug.log",
      "firebase-debug.*.log"
    ]
  },
  "firestore": {
    "database": "(default)",
    "location": "nam5",
    "rules": "firebase/firestore.rules",
    "indexes": "firebase/firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/",
        "destination": "https://chao-batido--capoeira-17aee.us-central1.hosted.app/",
        "type": 302
      },
      {
        "source": "/:path*",
        "destination": "https://chao-batido--capoeira-17aee.us-central1.hosted.app/:path",
        "type": 302
      }
    ]
  },
  "storage": {
    "rules": "firebase/storage.rules"
  },
  "auth": {
    "providers": {
      "emailPassword": true
    }
  },
  "emulators": {
    "auth": { "port": 9099 },
    "functions": { "port": 5001 },
    "firestore": { "port": 8080 },
    "storage": { "port": 9199 },
    "ui": { "enabled": true, "port": 4000 },
    "singleProjectMode": true
  }
}
