{
  "name": "chao-batido",
  "version": "2.0.0",
  "private": true,
  "description": "Site institucional e CMS da Associação de Capoeira Chão Batido.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/content",
    "test:watch": "vitest tests/content",
    "test:e2e": "playwright test",
    "test:rules": "npx -y firebase-tools@latest emulators:exec --only firestore,storage \"vitest run tests/rules\"",
    "migration:dry-run": "node scripts/migrate-v2.mjs",
    "migration:apply": "node scripts/migrate-v2.mjs --apply --confirm=capoeira-17aee",
    "migration:clean-orphans": "node scripts/clean-orphan-media.mjs",
    "build:functions": "npm --prefix functions run build",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build:functions && npm run build",
    "deploy": "npm run verify && firebase deploy"
  },
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "firebase": "^12.13.0",
    "firebase-admin": "^14.2.0",
    "lucide-react": "^0.468.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.2.12",
    "jsdom": "^27.2.0",
    "typescript": "^5.9.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  }
}
